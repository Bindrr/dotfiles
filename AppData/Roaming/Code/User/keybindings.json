    "key": "ctrl+n",
    "command": "explorer.newFile",
  },
  {
    "key": "ctrl+r",
    "command": "-workbench.action.openRecent",
  },
  {
    "key": "f1",
    "command": "-workbench.action.showCommands",
  },
  {
    "key": "ctrl+`",
    "command": "commandId",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+`",
    "command": "commandId",
    "when": "editorTextFocus",
  },
  {
    "key": "ctrl+alt+/",
